{
  "name": "rizzui-cli",
  "version": "0.1.0",
  "description": "CLI to scaffold RizzUI 2.x in Next.js: Tailwind v4, OKLCH tokens, optional next-themes, and subpath import help",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "rizzui-cli": "./dist/cli.js",
    "rizzui": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/copy-ui-sources.mjs",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "verify:ui-src": "node ./scripts/verify-ui-sources.mjs",
    "prepack": "pnpm run build && pnpm run verify:ui-src"
  },
  "keywords": [
    "rizzui",
    "cli",
    "tailwindcss",
    "nextjs",
    "react",
    "ui-library"
  ],
  "author": {
    "name": "REDQ",
    "url": "https://redq.io/"
  },
  "license": "MIT",
  "homepage": "https://rizzui.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rizzui/rizzui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/rizzui/rizzui/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^6.0.1",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "fs-extra": "^11.3.0",
    "ora": "^5.4.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.17.11",
    "tsconfig": "workspace:*",
    "tsup": "8.5.0",
    "tsx": "^4.20.6",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
